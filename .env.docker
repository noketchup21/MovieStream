# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=securepassword123
MONGO_DATABASE=moviestream

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
ACCESS_SECRET_KEY=your-super-secret-access-key-change-me
REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-me

# Email Configuration (Gmail example)
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
BASE_PROMPT_TEMPLATE=Analyze the following movie review and classify it into one of these categories: {rankings}. Return ONLY the category name, nothing else. Review:

# Recommended Movies Limit
RECOMMENDED_MOVIE_LIMIT=5
